<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <!-- Viewport crític per a aplicacions mòbils (evita zoom i scroll elàstic) -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Regals 3D - Mòbil</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #e0e6ed 0%, #f4f7fa 100%);
            touch-action: none; /* DESACTIVA gestos per defecte del navegador */
            user-select: none; /* Evita seleccionar text accidentalment */
            -webkit-user-select: none;
        }

        #scene-container { width: 100%; height: 100%; position: fixed; top: 0; left: 0; z-index: 1; }
        
        /* Navbar més compacta per a mòbil */
        #navbar {
            position: fixed; top: 1rem; left: 50%; transform: translateX(-50%);
            height: 2.5rem; padding: 0 1.5rem;
            background-color: rgba(30, 41, 59, 0.8); backdrop-filter: blur(8px);
            border-radius: 9999px; display: flex; align-items: center; justify-content: center;
            z-index: 10; white-space: nowrap;
        }

        #crosshair {
            position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 8px; height: 8px; border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.9); border: 1px solid rgba(0,0,0,0.2);
            z-index: 5; pointer-events: none;
        }

        /* UI de Controls Tàctils */
        .joystick-zone {
            position: fixed; bottom: 2rem; width: 120px; height: 120px;
            background: rgba(255, 255, 255, 0.1); border: 2px solid rgba(255,255,255,0.2);
            border-radius: 50%; z-index: 20;
            display: flex; justify-content: center; align-items: center;
        }
        .joystick-stick {
            width: 50px; height: 50px; background: rgba(255, 255, 255, 0.5);
            border-radius: 50%; pointer-events: none; position: absolute;
            transform: translate(0, 0); box-shadow: 0 4px 6px rgba(0,0,0,0.2);
        }
        #stick-left-zone { left: 2rem; }
        #stick-right-zone { right: 2rem; }

        /* Botó d'interacció gran */
        #interact-btn {
            position: fixed; bottom: 9rem; right: 2rem;
            width: 70px; height: 70px; border-radius: 50%;
            background-color: #4f46e5; color: white;
            display: flex; justify-content: center; align-items: center;
            font-weight: bold; font-size: 24px; z-index: 21;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            opacity: 0.5; pointer-events: none; transition: opacity 0.2s, transform 0.1s;
        }
        #interact-btn.active { opacity: 1; pointer-events: auto; transform: scale(1.1); background-color: #10b981; }

        /* Modal */
        #modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: rgba(0, 0, 0, 0.85); z-index: 100;
            display: flex; align-items: center; justify-content: center;
        }
        
        /* Avís d'orientació */
        #orientation-warning {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: #1e293b; z-index: 200;
            display: none; flex-direction: column;
            align-items: center; justify-content: center; text-align: center; color: white;
        }
        @media (orientation: portrait) {
            #orientation-warning { display: flex; }
        }
    </style>
</head>
<body>
    <!-- Avís de girar pantalla -->
    <div id="orientation-warning">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mb-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <h2 class="text-xl font-bold">Si us plau, gira el dispositiu</h2>
        <p class="text-gray-400 mt-2">Aquesta experiència està dissenyada per a mode apaïsat.</p>
    </div>

    <div id="scene-container"></div>
    <div id="navbar"><span id="nav-text" class="text-white text-sm font-semibold">Regals 3D</span></div>
    <div id="crosshair"></div>

    <!-- Controls Touch -->
    <div id="stick-left-zone" class="joystick-zone"><div id="stick-left" class="joystick-stick"></div></div>
    <div id="stick-right-zone" class="joystick-zone"><div id="stick-right" class="joystick-stick"></div></div>
    <div id="interact-btn">👋</div>

    <div id="modal-overlay" style="display:none;">
        <div id="modal-content" class="bg-white p-6 rounded-xl shadow-2xl max-w-sm mx-4 text-center">
            <!-- Contingut dinàmic -->
        </div>
    </div>

    <script>
        // --- CONFIGURACIÓ 3D ---
        let scene, camera, renderer, container, controls;
        const clock = new THREE.Clock();
        const raycaster = new THREE.Raycaster();
        let interactables = [];
        let playerVelocity = new THREE.Vector3();
        const RADIUS = 11;
        const speed = 0.4; // Una mica més lent per a mòbil per precisió

        // Variables de Control Tàctil
        let moveInput = { x: 0, y: 0 };
        let lookInput = { x: 0, y: 0 };

        // Referències DOM
        const statusText = document.getElementById('nav-text');
        const interactBtn = document.getElementById('interact-btn');
        const modal = document.getElementById('modal-overlay');
        const modalContent = document.getElementById('modal-content');

        const dadesRegals = [
            { nom: "FUNDA NINTENDO", urlTextura: "https://m.media-amazon.com/images/I/81fu1Gei7VL._AC_SX342_SY445_QL70_ML2_.jpg", urlAmazon: "https://www.amazon.es/HEYSTOP-Accesorio-Transporte-Protector-Apretones/dp/B07MR496WN/", escala: 2.0, descripcio: "Funda de transport per a Nintendo Switch." },
            { nom: "JBL GO 4 NEGRO", urlTextura: "https://m.media-amazon.com/images/I/71HdLDJEEUL._AC_SY300_SX300_QL70_ML2_.jpg", urlAmazon: "https://www.amazon.es/JBL-inal%C3%A1mbrico-Bluetooth-resistente-reproducci%C3%B3n/dp/B0CX5C6WP3/", escala: 1.5, descripcio: "Altaveu portàtil JBL GO 4." },
            { nom: "ADAPTADOR JACK", urlTextura: "https://m.media-amazon.com/images/I/61ShlRX2ipL._AC_SX679_.jpg", urlAmazon: "https://www.amazon.es/YMOO-Transmisor-Transmisi%C3%B3n-Smartphone-Auriculares/dp/B0BBZZXQTL", escala: 1.2, descripcio: "Adaptador Bluetooth cotxe." },
            { nom: "BASE XBOX X", urlTextura: "https://m.media-amazon.com/images/I/61g+CesQPAL._AC_SX679_.jpg", urlAmazon: "https://www.amazon.es/vertical-ventilador-estaci%C3%B3n-recargables-auriculares/dp/B08VNNSNPB", escala: 2.3, descripcio: "Base de càrrega Xbox." },
            { nom: "ADOPCIÓ GAT", urlTextura: "https://cdn.pixabay.com/photo/2023/06/29/12/28/cats-8096304_1280.jpg", urlAmazon: "https://ajuntament.barcelona.cat/benestaranimal/es/centro-de-acogida-de-animales-de-compania-caacb", escala: 1.8, descripcio: "Adopta un amic!" },
            { nom: "SAMSUNG WATCH", urlTextura: "https://m.media-amazon.com/images/I/51iEor5RZLL._AC_SX679_.jpg", urlAmazon: "https://www.amazon.es/Samsung-Bluetooth-Smartwatch-Procesador-Seguimiento/dp/B0FCGDMRLL/", escala: 1.0, descripcio: "Galaxy Watch 8 LTE." }
        ];

        function init() {
            container = document.getElementById('scene-container');
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0xf4f7fa);
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 1.7, 0);

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); // Limitar pixel ratio per rendiment mòbil
            renderer.shadowMap.enabled = true;
            container.appendChild(renderer.domElement);

            // Llums
            scene.add(new THREE.AmbientLight(0xffffff, 0.6));
            const dirLight = new THREE.DirectionalLight(0xffffff, 1);
            dirLight.position.set(5, 10, 7.5);
            dirLight.castShadow = true;
            scene.add(dirLight);

            // Escenari
            crearSol();
            crearRegals();

            // Controls (Objecte pare de la càmera)
            controls = new THREE.Object3D();
            controls.add(camera);
            scene.add(controls);

            // Inicialitzar Joysticks
            setupJoystick('stick-left-zone', 'stick-left', (x, y) => moveInput = { x, y });
            setupJoystick('stick-right-zone', 'stick-right', (x, y) => lookInput = { x, y });
            
            // Botó acció
            interactBtn.addEventListener('click', handleInteraction); // 'click' funciona en touch també
            interactBtn.addEventListener('touchstart', (e) => { e.preventDefault(); handleInteraction(); });

            animate();
            window.addEventListener('resize', onResize);
        }

        function crearSol() {
            const geometry = new THREE.PlaneGeometry(2, 2);
            for (let x = -20; x < 20; x += 2) {
                for (let z = -20; z < 20; z += 2) {
                    const color = (x/2 + z/2) % 2 === 0 ? 0xdddddd : 0xbbbbbb;
                    const tile = new THREE.Mesh(geometry, new THREE.MeshStandardMaterial({ color, metalness: 0.1 }));
                    tile.rotation.x = Math.PI / 2;
                    tile.position.set(x + 1, 0, z + 1);
                    tile.receiveShadow = true;
                    scene.add(tile);
                }
            }
        }

        function crearRegals() {
            const loader = new THREE.TextureLoader();
            dadesRegals.forEach((regal, index) => {
                const angle = (index * 2 * Math.PI) / dadesRegals.length;
                const mesh = new THREE.Mesh(
                    new THREE.PlaneGeometry(regal.escala, regal.escala),
                    new THREE.MeshStandardMaterial({ color: 0xcccccc, side: THREE.DoubleSide })
                );
                loader.load(regal.urlTextura, tex => { mesh.material.map = tex; mesh.material.color.set(0xffffff); mesh.material.needsUpdate = true; });
                mesh.position.set(Math.cos(angle) * RADIUS, regal.escala / 2 + 0.1, Math.sin(angle) * RADIUS);
                mesh.lookAt(0, mesh.position.y, 0);
                mesh.userData = { ...regal, isInteractable: true };
                scene.add(mesh);
                interactables.push(mesh);
            });
        }

        // --- LÒGICA DEL JOYSTICK TÀCTIL ---
        function setupJoystick(zoneId, stickId, callback) {
            const zone = document.getElementById(zoneId);
            const stick = document.getElementById(stickId);
            const maxDist = 35; // Distància màxima del stick
            let startX = 0, startY = 0;

            zone.addEventListener('touchstart', e => {
                e.preventDefault();
                const touch = e.changedTouches[0];
                startX = touch.clientX;
                startY = touch.clientY;
                stick.style.transition = 'none';
            });

            zone.addEventListener('touchmove', e => {
                e.preventDefault();
                const touch = e.changedTouches[0];
                let dx = touch.clientX - startX;
                let dy = touch.clientY - startY;
                const dist = Math.sqrt(dx*dx + dy*dy);
                
                // Limitar moviment al cercle
                if (dist > maxDist) {
                    const ratio = maxDist / dist;
                    dx *= ratio;
                    dy *= ratio;
                }

                stick.style.transform = `translate(${dx}px, ${dy}px)`;
                
                // Normalitzar valors (-1 a 1)
                callback(dx / maxDist, dy / maxDist);
            });

            const endHandler = e => {
                e.preventDefault();
                stick.style.transition = 'transform 0.2s';
                stick.style.transform = `translate(0px, 0px)`;
                callback(0, 0);
            };

            zone.addEventListener('touchend', endHandler);
            zone.addEventListener('touchcancel', endHandler);
        }

        // --- MOTOR DE JOC ---
        function update(delta) {
            // 1. Mirar (Rotation) - Joystick Dret
            // Invertim X per a gir natural
            controls.rotation.y -= lookInput.x * 2.0 * delta; 
            camera.rotation.x -= lookInput.y * 1.5 * delta; // Invertit per a control tipus càmera
            camera.rotation.x = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, camera.rotation.x));

            // 2. Moure (Movement) - Joystick Esquerre
            // Apliquem forces
            playerVelocity.x -= playerVelocity.x * 10.0 * delta;
            playerVelocity.z -= playerVelocity.z * 10.0 * delta;

            if (moveInput.y !== 0 || moveInput.x !== 0) {
                // Calcular direcció respecte a la càmera
                // Avançar/Retrocedir és Z, Lateral és X
                const direction = new THREE.Vector3(moveInput.x, 0, moveInput.y);
                direction.applyAxisAngle(new THREE.Vector3(0, 1, 0), controls.rotation.y);
                direction.normalize();

                const magnitude = Math.sqrt(moveInput.x**2 + moveInput.y**2);
                playerVelocity.addScaledVector(direction, speed * 60.0 * delta * magnitude);
            }

            controls.translateX(playerVelocity.x * delta);
            controls.translateZ(playerVelocity.z * delta);
            controls.position.y = 1.7; // Alçada fixa
        }

        function checkRaycast() {
            raycaster.setFromCamera({ x: 0, y: 0 }, camera);
            const intersects = raycaster.intersectObjects(interactables);
            
            // Reset colors
            interactables.forEach(obj => { if(obj.material) obj.material.emissive.setHex(0x000000); });

            if (intersects.length > 0) {
                const object = intersects[0].object;
                if (object.userData.isInteractable) {
                    object.material.emissive.setHex(0xaaaaaa);
                    statusText.textContent = object.userData.nom;
                    interactBtn.classList.add('active'); // Activa botó
                    return object;
                }
            }
            statusText.textContent = "Usa els controls per moure't";
            interactBtn.classList.remove('active');
            return null;
        }

        function handleInteraction() {
            const object = checkRaycast(); // Reutilitzem la lògica per saber què tenim davant
            if (object) {
                modalContent.innerHTML = `
                    <h2 class="text-2xl font-bold mb-2 text-gray-800">${object.userData.nom}</h2>
                    <p class="mb-4 text-gray-600 text-sm">${object.userData.descripcio}</p>
                    <div class="flex flex-col gap-2">
                        ${object.userData.urlAmazon ? `<a href="${object.userData.urlAmazon}" target="_blank" class="bg-green-600 text-white font-bold py-3 rounded-lg shadow">Veure a Amazon</a>` : ''}
                        <button onclick="document.getElementById('modal-overlay').style.display='none'" class="bg-indigo-600 text-white font-bold py-3 rounded-lg shadow">Tancar</button>
                    </div>
                `;
                modal.style.display = 'flex';
            }
        }

        function animate() {
            requestAnimationFrame(animate);
            const delta = clock.getDelta();
            update(delta);
            checkRaycast();
            renderer.render(scene, camera);
        }

        function onResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        window.onload = init;
    </script>
</body>
</html>
